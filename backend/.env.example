# Скопируйте в .env и правьте под своё окружение.
# docker-compose.yml подхватывает значения отсюда автоматически.

# База, пользователь и пароль, которые создаются внутри контейнера при первом запуске.
POSTGRES_DB=moderationdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Порт на хосте. Меняйте, если 5432 уже занят вашим локальным PostgreSQL.
POSTGRES_PORT=5432
